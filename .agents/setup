#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"

run_step() {
    local label="$1"
    shift
    local started_at=$SECONDS

    printf '\n==> %s\n' "$label"
    "$@"
    printf '<== %s completed in %ss\n' "$label" "$((SECONDS - started_at))"
}

install_bun() {
    local bun_version="1.3.10"

    if command -v bun >/dev/null 2>&1 && [[ "$(bun --version)" == "$bun_version" ]]; then
        printf 'Bun %s is already installed.\n' "$bun_version"
        return
    fi

    curl -fsSL https://bun.sh/install | bash -s "bun-v${bun_version}"
}

install_mint() {
    if ! command -v mint >/dev/null 2>&1; then
        bun add --global mint
    fi

    mkdir -p "$HOME/.local/bin"
    ln -sfn "$HOME/.bun/bin/mint" "$HOME/.local/bin/mint"
}

write_dev_vars() {
    local required=(BETTER_AUTH_SECRET RESEND_API_KEY EMAIL_FROM)
    local name value escaped

    for name in "${required[@]}"; do
        if [[ -z "${!name:-}" ]]; then
            printf 'Skipping .dev.vars: %s is not configured for this project.\n' "$name"
            return
        fi
    done

    umask 077
    : > .dev.vars
    for name in "${required[@]}"; do
        value="${!name}"
        escaped="${value//\\/\\\\}"
        escaped="${escaped//\"/\\\"}"
        printf '%s="%s"\n' "$name" "$escaped" >> .dev.vars
    done
    printf 'Wrote local Worker bindings from project configuration.\n'
}

run_step "Install pinned Bun toolchain" install_bun
run_step "Ensure Mintlify CLI is available" install_mint
run_step "Install repository dependencies" bun install --frozen-lockfile
run_step "Write local Worker bindings" write_dev_vars

printf '\nOrb setup complete.\n'
