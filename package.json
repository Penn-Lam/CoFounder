{
    "packageManager": "bun@1.3.10",
    "repository": "#",
    "license": "UNLICENSED",
    "scripts": {
        "start": "wrangler dev --port ${PORT:-8787} --persist-to .wrangler/state",
        "build": "webpack --config ./bundler/webpack.prod.js",
        "dev": "bun run build && bun run media:seed:local && bun run start",
        "deploy": "bun run build && bun run media:upload && wrangler deploy",
        "media:seed:local": "wrangler r2 object put cofounder-media/textures/monitor/video/real.mp4 --local --persist-to .wrangler/state --content-type video/mp4 --file r2-assets/textures/monitor/video/real.mp4",
        "media:upload": "wrangler r2 object put cofounder-media/textures/monitor/video/real.mp4 --remote --content-type video/mp4 --file r2-assets/textures/monitor/video/real.mp4",
        "test": "bun test",
        "typecheck": "tsc --noEmit --project src/tsconfig.json && tsc --noEmit --project worker/tsconfig.json"
    },
    "dependencies": {
        "@babel/core": "^7.16.12",
        "@babel/preset-env": "^7.16.11",
        "@babel/preset-react": "^7.16.7",
        "@tweenjs/tween.js": "^18.6.4",
        "@types/tweenjs": "^1.0.4",
        "babel-loader": "^8.2.3",
        "bezier-easing": "^2.1.0",
        "camera-controls": "^1.34.2",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^6.5.1",
        "file-loader": "^6.2.0",
        "framer-motion": "^6.3.1",
        "glslify": "^7.1.1",
        "glslify-import-loader": "^0.1.2",
        "glslify-loader": "^2.0.0",
        "gsap": "^3.9.1",
        "hono": "^4.13.8",
        "html-loader": "^3.1.0",
        "html-webpack-plugin": "^5.5.0",
        "lil-gui": "^0.16.0",
        "mini-css-extract-plugin": "^2.5.3",
        "raw-loader": "^4.0.2",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "stats.js": "^0.17.0",
        "style-loader": "^3.3.1",
        "three": "^0.137.5",
        "ts-loader": "^9.2.8",
        "typescript": "5.9.2",
        "webpack": "^5.68.0",
        "webpack-cli": "^5.1.4",
        "webpack-merge": "^5.8.0"
    },
    "devDependencies": {
        "@babel/preset-typescript": "^7.16.7",
        "@types/react": "^17.0.43",
        "@types/react-dom": "^17.0.14",
        "@types/stats.js": "^0.17.0",
        "@types/three": "^0.138.0",
        "wrangler": "^4.135.0"
    },
    "overrides": {
        "uuid": "11.1.1",
        "@types/node": "18.19.130",
        "@types/minimatch": "5.1.2"
    }
}
