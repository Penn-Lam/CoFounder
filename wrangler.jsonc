{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "cofounder",
    "main": "worker/app.ts",
    "compatibility_date": "2026-09-20",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "none",
        "run_worker_first": true,
    },
    "compatibility_flags": ["nodejs_compat"],
    "routes": [
        {
            "pattern": "cofounder.vergego.ai",
            "custom_domain": true,
        },
    ],
    "triggers": {
        "crons": ["* * * * *"],
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "cofounder",
            "database_id": "8677edba-f580-4779-a040-2e1593c2f2f2",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [
        {
            "binding": "MEDIA",
            "bucket_name": "cofounder-media",
        },
    ],
    "queues": {
        "producers": [
            {
                "binding": "REPORT_QUEUE",
                "queue": "cofounder-report-generation",
            },
        ],
        "consumers": [
            {
                "queue": "cofounder-report-generation",
                "max_batch_size": 5,
                "max_batch_timeout": 5,
                "max_retries": 5,
                "retry_delay": 15,
            },
        ],
    },
}
