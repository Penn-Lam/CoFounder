{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "cofounder",
    "main": "worker/app.ts",
    "compatibility_date": "2026-09-20",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "none",
        "run_worker_first": true,
    },
    "compatibility_flags": ["nodejs_compat"],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "cofounder",
            "database_id": "local-cofounder-d1",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [
        {
            "binding": "MEDIA",
            "bucket_name": "cofounder-media",
        },
    ],
}
