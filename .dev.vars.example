BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=Cofounder <onboarding@resend.dev>
JEV_API_KEY=jev_replace_with_typesafe_api_key
OPENROUTER_API_KEY=sk_or_replace_with_openrouter_api_key
